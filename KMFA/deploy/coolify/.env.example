# KMFA Coolify 环境变量键位清单（示例，无值）。
# 设置位置：Coolify → 该资源 → Environment Variables；敏感项勾 "Is Secret"
#   （Coolify 以其 APP_KEY 静态加密；compose 内只写 ${KEY} 占位，值绝不入仓 / 入日志）。
# 命名：UPPER_SNAKE。skills 读容器环境即可（缺值按既有设计告警 / 空跑，不阻塞起容器）。
# dws 登录态：**不是环境变量**——由 Coolify 托管的 named volume `kmfa-dws-auth` 持久；
#   Owner 首启做一次 `dws auth login --device`（手机点一次）即写入，之后无人值守（无 KMFA_DWS_TOKEN 这种键）。

# ==== 非敏感配置（普通 Env）====
# 投递总开关（双跑纪律：比对通过并经 Owner 同意前保持 0）
KMFA_DELIVERY_ENABLED=0
# 考勤 dws 双闸之一（dws 登录 + browser-policy 完成后置 1）
KMFA_DINGTALK_ATTENDANCE_ALLOW_DWS_COMMANDS=0
# 公共增强 App Shell；灰度异常时置 0 并重部署，仅回退到稳定静态壳，不动数据/私有面。
KMFA_PUBLIC_SHELL_ENABLED=1
# 搜索索引灰度；默认 0 会让根页保持人类可用，但 robots 全拒绝、sitemap 为空且根响应 noindex。
# 仅在根路径公开、私有路径与未发布 canary 负测全绿后置 1；回滚只需恢复 0 并重部署。
KMFA_PUBLIC_INDEXING_ENABLED=0
# S03/P3.4 早期匿名可恢复文件骨架；默认 0。仅在 app state named volume 已挂载、
# 重启/恢复/download-hash/Flag rollback Oracle 全绿后灰度置 1；回滚恢复 0，不删卷。
KMFA_WALKING_SKELETON_ENABLED=0
# P5.3 正常 recoverable-v1；紧急回滚置 paused，只停新上传，禁止降 schema/删对象。
KMFA_CONSISTENCY_STATE_MODE=recoverable-v1
# P5.4 默认 paused。只有 S3-compatible write backend 已迁移/对账、当前 schema 的隔离恢复演练
# 100% 通过、证明写入数据库且 lifecycle-worker profile 已启动后才可改 active；legacy filesystem
# 不支持生产 destructive lifecycle。回滚先恢复 paused。
KMFA_LIFECYCLE_MODE=paused
# S05/P5.1 expand/contract 默认保留 legacy-sqlite；Stage review 批准并完成只读迁移
# Oracle 后才可改 postgresql-primary，同时启用 postgresql compose profile。
KMFA_STRUCTURED_DATABASE_MODE=legacy-sqlite
# S05/P5.2 默认继续写 legacy-filesystem。只有私有 bucket、bucket-scoped 凭据、
# inventory 对账与下载 hash Oracle 均通过后，才可改为 s3。
KMFA_ARTIFACT_STORAGE_MODE=legacy-filesystem
# R2 示例为 https://<ACCOUNT_ID>.r2.cloudflarestorage.com；不得填 public bucket/custom-domain URL。
KMFA_S3_ENDPOINT_URL=
KMFA_S3_BUCKET=
# Cloudflare R2 使用 auto；其他 S3-compatible provider 按其官方区域值。
KMFA_S3_REGION=auto
# 应用级版本化固定前缀；对象 key 不含用户文件名。
KMFA_S3_PREFIX=kmfa/private/v1
KMFA_S3_ADDRESSING_STYLE=path
# 生产必须为 0；只允许本机私网 object-store fixture 显式置 1。
KMFA_S3_ALLOW_INSECURE_LOCAL=0
# PostgreSQL 初始化库名/角色名（非凭据）。
KMFA_POSTGRES_DB=kmfa
KMFA_POSTGRES_USER=kmfa
# S04/P4.4 匿名安全策略。生产正常值 enforced；未知值会让全部受保护操作 fail closed。
# 紧急时只能切 emergency-expensive-only，继续限制 identity/recovery/upload/export，禁止 off。
KMFA_ABUSE_POLICY_MODE=enforced
# Owner 2026-08-10 已要求 KMFA 经营驾驶舱公开、无需登录。生产必须通过
# `coolify-ops` 的 `public-dashboard` 同步精确 Access Bypass 与此源站开关；
# 不能只改其中一边。若 Owner 日后恢复私有面，先恢复精确路径 Access 策略，再设回 1。
KMFA_PRIVATE_OPS_REQUIRE_ACCESS=0
# Cloudflare Zero Trust team domain，可填主机名或 https URL（非 token/凭据）。
KMFA_CLOUDFLARE_ACCESS_TEAM_DOMAIN=
# 保留 Access team domain / Audience tags 仅作可逆运维配置记录。当前 Owner 公开模式
# 不依赖它们；恢复私有面前必须重新核对精确路径 Application 与 Audience tags。
KMFA_CLOUDFLARE_ACCESS_AUD=

# ==== 每日资金独立云端切片（不与既有 DWS / skills 复用）====
# 这组键只注入 daily-funds 容器；缺任一关键值时 worker 状态为“需处理”，
# 不会回退读取 KMFA_*、本机文件、其他 skill 的 profile 或登录态。
DAILY_FUNDS_PRIVATE_REPO=git@github.com:LinzeColin/Private-Database.git
DAILY_FUNDS_PRIVATE_BRANCH=main
DAILY_FUNDS_OCI_REGION=ap-chuncheon-1
# 离线 Tesseract OCR 仅在图片/扫描 PDF 走回退路径时启用；它不是模型/API。
# 关键日期、金额和标识低于 0.98，或未完成两业务日版式校准时一律不发布。
DAILY_FUNDS_OCR_ENABLED=1
DAILY_FUNDS_OCR_MIN_CONFIDENCE=0.98

# ==== 敏感（Coolify 勾 "Is Secret"）====
# 钉钉群机器人（群投递通道）
DINGTALK_ROBOT_URL=
DINGTALK_ROBOT_SIGNING_KEY=
# 钉钉个人 DING 通道
DINGTALK_DING_ROBOT_CODE=
# 云端失败告警 webhook token（run_skill.sh 实读此名——勿简写为 KMFA_ALERT_WEBHOOK）
KMFA_ALERT_WEBHOOK_TOKEN=
# Private-Database 只读 token：项目成本运行只按私有 manifest 下载被选定文件，
# 禁止回退为 git clone。只需 contents:read，务必使用独立最小权限凭据。
KMFA_PRIVATE_DB_READ_TOKEN=
# 加密工资表密码：只进 Coolify Secret，不进代码、命令参数、日志或制品。
KMFA_PAYROLL_PASSWORD=
# PostgreSQL 官方镜像初始化密码；只在 Coolify Secret 中设置。
KMFA_POSTGRES_PASSWORD=
# URL-encode 后的完整 PostgreSQL DSN；只在 Coolify Secret 中设置，禁止作为 CLI 参数。
KMFA_STRUCTURED_DATABASE_URL=
# 仅授予目标私有 bucket（能支持时再缩到上述 prefix）的 S3 access key；不得使用账户全局 key。
KMFA_S3_ACCESS_KEY_ID=
KMFA_S3_SECRET_ACCESS_KEY=
# 独立删除工人凭据：只授予固定私有 prefix 的 list/get/delete-version。
# 必须与应用 read/write key 和账户全局 key 不同，绝不能注入 app 服务。
KMFA_S3_LIFECYCLE_ACCESS_KEY_ID=
KMFA_S3_LIFECYCLE_SECRET_ACCESS_KEY=
# 目标群与发送人均为唯一 ID；发送人必须使用 DWS 返回的 senderOpenDingTalkId，
# 不是显示名 sender。只在 Coolify Secret 保存，不入 public Git、日志或页面。
DAILY_FUNDS_GROUP_ID=
DAILY_FUNDS_SENDER_ID=
# 可选：每日资金专用 DWS client ID 覆盖值；留空时使用 DWS 官方默认客户端。
# 如配置，仅注入独立容器构造的 DWS 环境，不得复用 kmfa-dws-auth named
# volume 或其他服务的环境覆盖。
DAILY_FUNDS_DWS_CLIENT_ID=
# 可选：专用 DWS 身份的 Linux 可迁移认证包（`dws auth export --base64`）。
# 首选路径是通过 Cloudflare Access 保护的 KMFA “每日资金”页面发起一次
# 固定设备授权；它只写 daily-funds 容器自己的云端卷。若该私有入口临时
# 不可用，才在同一容器的受保护云端终端运行 `bootstrap-dws-auth`。此项只
# 用于灾备恢复，不是上线前提。
# 不要额外向容器注入 AppSecret，也不要用 AppKey/AppSecret 替代可刷新的登录态。
DAILY_FUNDS_DWS_AUTH_BUNDLE_B64=
# 仅对 Private-Database 的每日资金 sparse 路径具写权限的专用 deploy-key 私钥（base64 单行）。
DAILY_FUNDS_GIT_SSH_KEY_B64=
# 最小权限 Cloudflare token、账户 ID、每日资金专用 D1 数据库 ID。
DAILY_FUNDS_CLOUDFLARE_API_TOKEN=
DAILY_FUNDS_CF_ACCOUNT_ID=
DAILY_FUNDS_D1_DATABASE_ID=
# 非生产、独立 D1 数据库 ID：每月从 OCI 恢复制品重建并跑 Query Oracle；严禁填正式 D1 ID。
DAILY_FUNDS_RESTORE_DRILL_D1_DATABASE_ID=
# Cloudflare R2 热镜像凭据（S3-compatible，bucket 只限每日资金）。
DAILY_FUNDS_R2_ENDPOINT_URL=
DAILY_FUNDS_R2_BUCKET=
DAILY_FUNDS_R2_ACCESS_KEY_ID=
DAILY_FUNDS_R2_SECRET_ACCESS_KEY=
# R2 零付费守卫的保守单轮上限：31 天、每 15 分钟全为新对象时仍低于
# Standard 免费额度的 40%。禁止调大到校验无法通过的值；禁止 IA。
DAILY_FUNDS_R2_MAX_NEW_OBJECTS_PER_POLL=100
DAILY_FUNDS_R2_MAX_NEW_BYTES_PER_POLL=1000000
# OCI Object Storage 异地冷备：生产优先使用仅限专用桶的 HTTPS 读写 PAR。
# 不要把它写入仓库、日志或普通环境变量；仅放 GitHub/Coolify secret。
DAILY_FUNDS_OCI_PAR_URL=
# 兼容既有 S3/HMAC 恢复场景：只有不使用 PAR 时才需完整填四项；不得与 PAR 混用。
DAILY_FUNDS_OCI_ENDPOINT_URL=
DAILY_FUNDS_OCI_BUCKET=
DAILY_FUNDS_OCI_ACCESS_KEY_ID=
DAILY_FUNDS_OCI_SECRET_ACCESS_KEY=
