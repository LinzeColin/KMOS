# KMFA skills 云端凭据键位清单（示例，无值）。
# 真实文件：云主机 /opt/kmfa/secrets/skills.env，权限 600，任何情况不入仓。

# —— 守卫开关（考勤 dws_auth_guard 的 READY 条件之一；dws 登录+browser-policy 完成后置 1）
KMFA_DINGTALK_ATTENDANCE_ALLOW_DWS_COMMANDS=

# —— 投递总开关（双跑纪律：比对通过并经 Owner 同意前保持 0）
KMFA_DELIVERY_ENABLED=

# —— 钉钉群机器人（群投递通道，按渠道解析文件的键位）
DINGTALK_ROBOT_URL=
DINGTALK_ROBOT_SIGNING_KEY=

# —— 钉钉个人 DING 通道（notifier_dws_personal_chat 的 dws_ding_personal 渠道）
DINGTALK_DING_ROBOT_CODE=

# —— 云端失败告警 webhook（run_skill.sh 使用；建议指向 Owner 个人/测试群）
KMFA_ALERT_WEBHOOK_TOKEN=

# —— App 状态面异地备份凭据（daily-backup 用）——首选部署密钥，其次 token，都空则降级
#    【首选】KMFA_BACKUP_SSH_KEY_B64：专用私有备份库 KMFA-App-State-Backup 的**部署密钥私钥(base64 单行)**。
#      agent 已生成密钥并把公钥装为该库可写部署密钥；base64 私钥在 Owner 本机
#      _protected/kmfa_backup_deploy_key.b64。把那一行粘进 Coolify skills 服务此项即可。
#      （entrypoint 启动时解到 600 文件、只把路径给 cron；用专用库而非 Private-Database=最小爆炸
#       半径：此密钥只能读写备份，读不到财务源。）→ 每日 00:30 北京自动异地备份。
KMFA_BACKUP_SSH_KEY_B64=
#    【备选】KMFA_BACKUP_GH_TOKEN：对 Private-Database 有 contents:write 的 GitHub token（REST 路径）。
KMFA_BACKUP_GH_TOKEN=
#    两者都空 = 降级：只写命名卷 /var/log/kmfa/backups（扛重部署，但整机损毁会丢）——启动日志会告警。

# —— 考勤根目录覆盖（容器内仓库路径固定时通常不需要）
# KMFA_ATTENDANCE_LOCAL_KMFA_ROOT=/opt/kmfa/KMOS/KMFA
