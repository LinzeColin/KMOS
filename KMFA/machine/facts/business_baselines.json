{
  "schema_version": "kmfa.business_baselines.v1",
  "authority": "Owner 2026-07-26：以后都用 skill 管理业务基线（纵向切片）；每条基线必须端到端运维健康可见，并建立耦合治理。",
  "stage_model": [
    {
      "id": "intake",
      "name": "源接入",
      "meaning": "原始数据进入系统（上游归档/私有库/人工上传）"
    },
    {
      "id": "parse",
      "name": "解析",
      "meaning": "读成结构化记录（版式适配、字段定位）"
    },
    {
      "id": "compute",
      "name": "计算",
      "meaning": "按业务口径出结果（成本归集、分摊、汇总）"
    },
    {
      "id": "verify",
      "name": "校验",
      "meaning": "恒等式/对账门禁（不通过不得出正式结果）"
    },
    {
      "id": "output",
      "name": "输出",
      "meaning": "生成交付件（与业务原格式一致的表/报告）"
    },
    {
      "id": "deliver",
      "name": "投递",
      "meaning": "送达（App 下载 / 钉钉 / 邮件），测试期受禁群约束"
    }
  ],
  "status_enum": [
    "healthy",
    "degraded",
    "blocked",
    "not_built"
  ],
  "baselines": [
