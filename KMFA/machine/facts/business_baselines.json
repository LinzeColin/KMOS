{
  "schema_version": "kmfa.business_baselines.v1",
  "authority": "Owner 2026-07-26：以后都用 skill 管理业务基线（纵向切片）；每条基线必须端到端运维健康可见，并建立耦合治理。",
  "stage_model": [
    {
      "id": "intake",
      "name": "源接入",
      "meaning": "原始数据进入系统（上游归档/私有库/人工上传）"
    },
    {
      "id": "parse",
      "name": "解析",
      "meaning": "读成结构化记录（版式适配、字段定位）"
    },
    {
      "id": "compute",
      "name": "计算",
      "meaning": "按业务口径出结果（成本归集、分摊、汇总）"
    },
    {
      "id": "verify",
      "name": "校验",
      "meaning": "恒等式/对账门禁（不通过不得出正式结果）"
    },
    {
      "id": "output",
      "name": "输出",
      "meaning": "生成交付件（与业务原格式一致的表/报告）"
    },
    {
      "id": "deliver",
      "name": "投递",
      "meaning": "送达（App 下载 / 钉钉 / 邮件），测试期受禁群约束"
    }
  ],
  "status_enum": [
    "healthy",
    "degraded",
    "blocked",
    "not_built"
  ],
  "baselines": [
    {
      "id": "BL-PROJECT-COST",
      "skill": "项目成本表",
      "name": "项目成本",
      "priority": "P0",
      "owner_note": "Owner 2026-07-26 指定最紧急",
      "upstream": [
        "SRC-KINGDEE",
        "SRC-TAX",
        "SRC-REDCIRCLE",
        "SRC-PAYROLL",
        "BL-UPSTREAM-ARCHIVE"
      ],
      "downstream": [
        "PROD.0006",
        "PROD.0005"
      ],
      "stages": {
        "intake": {
          "status": "healthy",
          "evidence": "9 类输入齐备（8PDF+1xlsx 基准 + 金蝶/税务/红圈/工资/外协/贷款/报表系列一）；仅日记账覆盖至 2025-09"
        },
        "parse": {
          "status": "healthy",
          "evidence": "双模板解析 8/8（模板A 合计支出+毛利；模板B 税金/分摊入二级+利润）"
        },
        "compute": {
          "status": "blocked",
          "evidence": "全账扫描定案：只有 收入/生产成本/主营业务成本/应收账款 四类科目带项目号（劳务成本·原材料·应付账款·期间费用 皆 0%）。源包内每本明细账重复 3 份需去重；净额口径会把归集与结转对冲成 0，正确取生产成本借方发生额。按此重算，8 个基准项目只覆盖各自『二』的 0.06%～60%——按项目的完整成本无法从现有导出算出"
        },
        "verify": {
          "status": "blocked",
          "evidence": "溯源定案（2 位精度归一、全库 1292 文件）：八份报表成本侧 62 个金额只有 13 个能在源数据里找到且多为整数巧合撞号；『二』『合计支出』『（四）现场管理费』无一命中。无底稿则既不能复现也不能验证。表内恒等式 A/B 8/8 成立仍有效，但那只是自洽，不是可溯源"
        },
        "output": {
          "status": "degraded",
          "evidence": "渲染器 KMFA/tools/project_cost/render_report.py 严格复刻源报表行序（模板A 44 行 / 模板B），千分位两位小数、缺值留空不臆造，4 项回归测试过；输入矩阵 KMFA/tools/project_cost/input_matrix.py 已上门禁。降级原因：上游 compute/verify 阻断，只能出『可算部分』"
        },
        "deliver": {
          "status": "not_built",
          "evidence": "需接 App 上传新项目→出表→下载"
        }
      },
      "known_defects": [
        "根因：占生产成本约八成的『劳务费』有约七成记进『不分项目』占位，八个基准项目名下劳务费为 0——不解决记账口径，项目成本自动化只能算出零头",
        "3 份源报表所印毛利用其表内数字算不出（两种公式均证伪）→ 统一按 合同额−合计支出 重算并逐项标注",
        "八份历史报表的成本侧在全部源数据中查无实据（62 个金额仅 13 个可见且多为巧合）——机制不存在于数据里，须 Owner 提供底稿",
        "『（四）现场管理费』是黑箱：某项目占其全部成本九成以上，账上无对应归集",
        "金蝶项目辅助核算只覆盖 4 类科目，成本大头未启用——不修则未来项目同样算不准",
        "源包内每本明细账存在 3 份同 CRC 副本，任何计算必须先按账簿名去重",
        "合同号序号跨年重复，禁止按序号跨编号归并（已验证会把不同项目并到一起）"
      ]
    },
