# 考勤异常简报 —— 环境变量模板
# 复制到本机 private_runtime/kmfa_brief.env 后填真值。
# 仓库里只放键名，群 ID / userId 等真值永远不进 Git。

KMFA_RUN_SLOT=evening

# —— 数据源 ——
# 生产管理群 openConversationId：dws chat search --query "生产管理"
KMFA_BRIEF_GROUP_ID=
# 人员表发布人（逗号分隔）
# 人员表发布人的钉钉昵称，逗号分隔。用来筛出是谁发的图，不会印进简报。
KMFA_BRIEF_PUBLISHERS=姓名A,姓名B

# —— 落点：全部在 SMB ——
KMFA_BRIEF_ARCHIVE_ROOT=/Volumes/share/03_资料库/MetaData/KMFA_MetaData/20_薪酬与绩效/考勤/dingtalk_attendance
KMFA_BRIEF_RUNTIME_ROOT=/Volumes/share/03_资料库/MetaData/KMFA_MetaData/KMFA/attendance_brief_runtime

# —— 发送目标 ——
# 张霖泽 userId：dws contact user search --query "张霖泽"
KMFA_BRIEF_NOTIFY_USER=
# 验收通过前留空 = 不发群。通过后再填生产管理群 openConversationId。
KMFA_BRIEF_NOTIFY_GROUP=
# 0=只出报不发送（验收期用 1 才真发个人）
KMFA_BRIEF_SEND=0

# —— 运行 ——
KMFA_BRIEF_TIMEOUT=330
# 不要在这里写 KMFA_BRIEF_DWS —— 代码里默认就是 ~/.local/bin/dws。
# 写在这里会被 cron 包装脚本 source 进来、盖掉外面临时设的替身，
# 于是「拿替身试跑」会静默变成真发进群。踩过一次。
# KMFA_BRIEF_DWS=~/.local/bin/dws

# 兜底时刻（小时，24 制）。早于它却没拿到人员表 = 还没发，静默退出不打扰；
# 到点仍没有才发降级说明。实测人员表 16:00 前仅 5% 发出、18:00 前 100% 发出。
KMFA_BRIEF_FINAL_HOUR=18

# 出报前跑 KMFile + KMMedia 全量增量的合计墙钟预算（秒），默认 2400。
# 实测全量一轮各要 15~20 分钟以上，别调到 900 以下，否则每天都会被掐断。
# 这是时间闸不是范围闸 —— 命令行里始终不带任何白名单/类型过滤参数。
# 代码里已有默认值；只在实测发现 900 秒不够时才需要在这里覆盖。
# KMFA_BRIEF_ARCHIVE_BUDGET=2400

# 出报时刻（北京时间），默认 17:15。**这同时也是人员表的截止线** ——
# 简报什么时候发，人员表就得在那之前到，晚于它就是迟发。
# 它还是「两个触发钟点里挑哪一个」的判据。
# 改了它必须同步改 Codex 那两条 automation 的钟点，以及 kmfa_brief_cron.sh 里的 SLOT_*。
# KMFA_BRIEF_PUBLISH_HOUR=17
# KMFA_BRIEF_PUBLISH_MINUTE=15
# 截止线默认等于出报时刻。只有确实要把两者分开时才设它，正常别动。
# KMFA_BRIEF_DEADLINE=17:15

# ——— 考勤累计（越线通知 + 周一月报，automation-2 上午跑）———
# 只看这个部门的全口径（含所有下级班组/项目组）。老板定的：这条规则只对生产部。
KMFA_BRIEF_DEPT_ROOT=生产部
# 出勤天数门槛。判定是「昨天累计 <= 它、今天累计 > 它」，不写死任何数字，
# 改成别的数、或者按当月天数浮动（例如当月天数 - 6），改这一个值就行。
KMFA_BRIEF_ATTEND_THRESHOLD=24
# 发送窗口（北京时间，分钟）。上下沿都有，谁触发的都不放行。
KMFA_BRIEF_MONTHLY_FROM=480
KMFA_BRIEF_MONTHLY_TO=720
