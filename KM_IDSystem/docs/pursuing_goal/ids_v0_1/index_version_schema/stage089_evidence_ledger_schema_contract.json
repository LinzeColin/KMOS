      {
        "grade": "A",
        "label": "高可信候选",
        "future_use_rule": "仅可作为业务线白箱人工复核的高可信候选依据，不自动形成业务结论。"
      },
      {
        "grade": "B",
        "label": "较高可信候选",
        "future_use_rule": "需保留来源溯源与交叉核验引用，不自动形成业务结论。"
      },
      {
        "grade": "C",
        "label": "受限可信候选",
        "future_use_rule": "必须披露证据缺口或风险状态，不能单独支撑关键结论。"
      },
      {
        "grade": "D",
        "label": "低可信",
        "future_use_rule": "不得单独支撑关键结论，必须保持降级并等待人工处理。"
      },
      {
        "grade": "E",
        "label": "不可作为结论依据",
        "future_use_rule": "不得进入关键结论、报告采纳或业务决策；撤回或投毒疑似状态只能在后续授权运行时处理。"
      }
