    "parameter_provenance": {
      "lease_duration_seconds": {
        "unit": "seconds",
        "source": "STAGE041_PHASE2_LOCAL_ENGINEERING_SAFETY_BOUNDARY",
        "rationale": "Three renewal intervals create two missed-renewal opportunities before expiry in the isolated logical-clock slice.",
        "policy_version": "ids.lock_registry_policy.v0_1.stage041.p2",
        "validation_evidence": "check_lock_registry_runtime.py#evaluate_contract_and_renew",
        "rollback": "DISABLE_ISOLATED_LOCK_RUNTIME_REQUIRE_MANUAL_REVIEW"
      },
      "renewal_interval_seconds": {
        "unit": "seconds",
        "source": "STAGE041_PHASE2_LOCAL_ENGINEERING_SAFETY_BOUNDARY",
        "rationale": "One third of the lease duration keeps renewal strictly before expiry without wall-clock sleeping.",
        "policy_version": "ids.lock_registry_policy.v0_1.stage041.p2",
        "validation_evidence": "check_lock_registry_runtime.py#evaluate_contract_and_renew",
        "rollback": "DISABLE_ISOLATED_LOCK_RUNTIME_REQUIRE_MANUAL_REVIEW"
      },
      "expiry_grace_seconds": {
        "unit": "seconds",
        "source": "STAGE041_PHASE2_LOCAL_ENGINEERING_SAFETY_BOUNDARY",
        "rationale": "A finite grace smaller than one renewal interval prevents expiry observation alone from granting takeover.",
        "policy_version": "ids.lock_registry_policy.v0_1.stage041.p2",
        "validation_evidence": "check_lock_registry_runtime.py#takeover",
        "rollback": "DISABLE_ISOLATED_LOCK_RUNTIME_REQUIRE_MANUAL_REVIEW"
      },
      "acquisition_timeout_seconds": {
        "unit": "seconds",
        "source": "STAGE041_PHASE2_LOCAL_ENGINEERING_SAFETY_BOUNDARY",
        "rationale": "The isolated decision has a finite one-second policy ceiling while executing synchronously without sleep.",
        "policy_version": "ids.lock_registry_policy.v0_1.stage041.p2",
        "validation_evidence": "check_lock_registry_runtime.py#evaluate_contract",
        "rollback": "DISABLE_ISOLATED_LOCK_RUNTIME_REQUIRE_MANUAL_REVIEW"
      },
      "maximum_wait_seconds": {
        "unit": "seconds",
        "source": "STAGE038_RESOURCE_CONFLICT_ACTIVE_BASELINE",
        "rationale": "Zero blocking wait preserves pause-before-queue behavior and creates no hidden wait queue.",
        "policy_version": "ids.lock_registry_policy.v0_1.stage041.p2",
        "validation_evidence": "check_lock_registry_runtime.py#acquire",
        "rollback": "DISABLE_ISOLATED_LOCK_RUNTIME_REQUIRE_MANUAL_REVIEW"
      },
      "retry_jitter_seconds": {
        "unit": "seconds",
        "source": "STAGE039_RETRY_OWNERSHIP_BOUNDARY",
        "rationale": "Zero lock-local jitter preserves Stage039 ownership and ensures contention consumes no retry budget.",
        "policy_version": "ids.lock_registry_policy.v0_1.stage041.p2",
        "validation_evidence": "check_lock_registry_runtime.py#acquire",
        "rollback": "DISABLE_ISOLATED_LOCK_RUNTIME_REQUIRE_MANUAL_REVIEW"
      },
      "deadlock_timeout_seconds": {
        "unit": "seconds",
        "source": "STAGE041_PHASE1_CANONICAL_ALL_OR_NONE_CONTRACT",
        "rationale": "A finite guard is registered even though canonical all-or-none acquisition performs no blocking wait in this slice.",
        "policy_version": "ids.lock_registry_policy.v0_1.stage041.p2",
        "validation_evidence": "check_lock_registry_runtime.py#evaluate_contract",
        "rollback": "DISABLE_ISOLATED_LOCK_RUNTIME_REQUIRE_MANUAL_REVIEW"
      }
    },
    "parameter_relationships": [
      "lease_duration_seconds == 3 * renewal_interval_seconds",
      "0 < expiry_grace_seconds < renewal_interval_seconds < lease_duration_seconds",
