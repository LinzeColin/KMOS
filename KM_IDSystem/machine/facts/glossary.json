  "terms": [
    {
      "英文": "LLM",
      "中文": "待补中文",
      "说明": "来自功能名，待复审确认释义"
    },
    {
      "英文": "CAS",
      "中文": "比较并交换",
      "说明": "用预期栅栏令牌和完整锁版本确认当前状态后再执行原子更新"
    },
    {
      "英文": "TDD",
      "中文": "测试驱动开发",
      "说明": "先固定失败断言，再实现到通过的开发方式"
    },
    {
      "英文": "RED",
      "中文": "红灯阶段",
      "说明": "测试驱动开发中确认新测试按预期失败的阶段"
    },
    {
      "英文": "run",
      "中文": "单轮执行",
      "说明": "一次只处理一个明确步骤并在停止门结束的受控执行"
    },
    {
      "英文": "PROPOSED",
      "中文": "提议值",
      "说明": "已有工程来源与约束但尚未完成生产校准的事实等级"
    },
    {
      "英文": "commit",
      "中文": "提交对象",
      "说明": "固定某一时点仓库内容及父链的 Git 提交身份"
    },
    {
      "英文": "tree",
      "中文": "目录树对象",
      "说明": "固定某次提交内 KM_IDSystem 目录内容的 Git 对象"
    },
    {
      "英文": "drive",
      "中文": "外接存储设备",
      "说明": "资源门检查的外接存储可用性信号，不代表本轮执行物理拔盘"
    },
    {
      "英文": "disk",
      "中文": "磁盘空间",
      "说明": "项目文件系统的只读可用空间观察，不代表本轮分配或填充磁盘"
    },
    {
      "英文": "tombstone version",
      "中文": "墓碑版本",
      "说明": "锁释放后保留的单调版本号，用于拒绝旧持有者凭证；本阶段只存在于进程内存"
    },
    {
      "英文": "fail-closed",
      "中文": "失败关闭",
      "说明": "来源、合同或证据不完整时停止并要求人工复核，不继续执行或放宽安全门"
    },
    {
      "英文": "allowlist",
      "中文": "允许清单",
      "说明": "仅列明允许进入某一受控动作的类别；未列项目默认禁止并要求复核"
    },
    {
      "英文": "admission",
      "中文": "准入",
      "说明": "任务进入队列或执行链前必须通过的控制门"
    },
    {
      "英文": "backpressure",
      "中文": "背压",
      "说明": "资源或容量不足时限制新任务进入并保持失败关闭"
    },
    {
      "英文": "cleanup",
      "中文": "清理",
      "说明": "仅对允许清单内可重建临时产物执行的受控删除动作"
    },
    {
      "英文": "crash",
      "中文": "进程崩溃",
      "说明": "工作进程非正常终止；恢复运行时归 Stage 43 管理"
    },
    {
      "英文": "dead-letter",
      "中文": "死信",
      "说明": "重试预算耗尽后停止自动处理并等待人工复核的任务状态"
    },
    {
      "英文": "fencing",
      "中文": "栅栏保护",
      "说明": "用单调令牌拒绝过期锁持有者继续写入的控制机制"
    },
    {
      "英文": "guard",
      "中文": "保护条件",
      "说明": "状态迁移或动作执行前必须满足的失败关闭条件"
    },
    {
      "英文": "lock",
      "中文": "锁",
      "说明": "用于排除同一受保护资源并发写入的所有权记录"
    },
    {
      "英文": "ordered",
      "中文": "有序",
      "说明": "动作必须按合同声明的固定先后次序执行"
    },
    {
      "英文": "ownership",
      "中文": "职责归属",
      "说明": "明确某项运行时能力由哪个阶段负责实现与复审"
    },
    {
      "英文": "predecessor",
      "中文": "前置阶段",
      "说明": "当前阶段进入前必须已完成并绑定证据的上游阶段"
    },
    {
      "英文": "queue",
      "中文": "队列",
      "说明": "保存已准入控制任务及其调度顺序的逻辑结构"
    },
    {
      "英文": "recovery",
      "中文": "恢复",
      "说明": "异常或暂停后在重新校验资源与所有权后继续处理的受控过程"
    },
    {
      "英文": "reference-only",
      "中文": "仅供引用",
      "说明": "只允许作为合同或证据输入，不代表已激活对应运行时"
    },
    {
      "英文": "reopen",
      "中文": "重新打开",
      "说明": "将已关闭或终态对象恢复为可执行状态；终态对象禁止此动作"
    },
    {
      "英文": "retry",
      "中文": "重试",
      "说明": "满足版本化策略、资源门与预算后再次安排同一受控操作"
    },
    {
      "英文": "reviewed",
      "中文": "已复审",
      "说明": "已完成独立阶段复审并保留本地证据，但不等于生产启用"
    },
    {
      "英文": "shutdown",
      "中文": "关闭",
      "说明": "停止新准入、收敛已接收工作并释放所有权的有序过程"
    },
    {
      "英文": "terminal",
      "中文": "终态",
      "说明": "任务生命周期不可原地重新打开的最终状态"
    },
    {
      "英文": "worker",
      "中文": "工作进程",
      "说明": "领取并执行已准入队列任务的受控执行单元"
    },
    {
      "英文": "worktree",
      "中文": "工作树",
      "说明": "与主树隔离并绑定独立分支的 Git 开发目录"
    }
  ]
}
